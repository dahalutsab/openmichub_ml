# Copy to .env and fill in. Never commit .env.
# The service reads these via ${VAR} placeholders in application-local.yml.

# --- database (matches docker-compose.yml defaults) ---
DB_URL=jdbc:postgresql://localhost:5432/open_mic_hub
DB_USERNAME=postgres
DB_PASSWORD=root

# --- initial admin (omit to skip admin seeding entirely) ---
ADMIN_EMAIL=admin@openmichub.com
ADMIN_PASSWORD=

# --- khalti payment gateway ---
# Sandbox: https://dev.khalti.com/api/v2   Production: https://khalti.com/api/v2
# Leaving the key blank does not disable checkout quietly: every payment attempt
# fails with 502 and "the Khalti secret key is not configured". Get a sandbox key
# from https://dev.khalti.com/ (Merchant -> Settings -> Keys) and paste it here.
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
KHALTI_SECRET_KEY=

# --- gmail smtp (use an app password, not the account password) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- github models token for the chat assistant ---
CHATBOT_API_KEY=

# --- browser origins allowed to call the API (comma-separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- where uploaded media is written ---
UPLOAD_DIR=./uploads

# --- ml service ---
ML_SERVICE_URL=http://ml:8000
ML_PORT=8000

# ---------------------------------------------------------------------------
# Social sign-in (optional)
#
# Leave blank and the buttons stay off; the app boots and password login is
# unaffected. Set a provider's pair, restart, and its button appears on the
# sign-in page — the page asks the backend which providers are usable, so there
# is nothing to change in the front end.
#
# Google:   console.cloud.google.com -> APIs & Services -> Credentials
#           -> OAuth client ID -> Web application
#           Authorised redirect URI: http://localhost:8181/login/oauth2/code/google
#
# Facebook: developers.facebook.com -> My Apps -> Create App -> Facebook Login
#           Valid OAuth Redirect URI: http://localhost:8181/login/oauth2/code/facebook
#           Facebook requires HTTPS for anything beyond your own test users.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
